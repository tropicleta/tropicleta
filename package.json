{
  "name": "tropicleta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test:accounting": "node --conditions=react-server --import tsx tests/accounting.test.ts",
    "db:reset-local": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\" && echo 'BD local borrada; se recrea al iniciar'",
    "test:admin": "node --conditions=react-server --import tsx tests/admin.test.ts",
    "test:catalog": "node --import tsx tests/catalog.test.ts",
    "test:shop": "node --conditions=react-server --import tsx tests/shop-readiness.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sparticuz/chromium": "147.0.0",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.3",
    "mercadopago": "^3.6.1",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "puppeteer-core": "25.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "transbank-sdk": "^6.1.1",
